# Database Configuration
# MongoDB connection URI (e.g. mongodb+srv://username:password@cluster.mongodb.net/dbname)
MONGODB_URI=
JWT_SECRET=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini / Maps API Keys
# Gemini API Key (used by @ai-sdk/google in query-resolver and recommend routes)
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# Third-Party APIs
# Groq API Key
GROQ_API_KEY=

# Google Calendar Integration (Optional)
NEXT_PUBLIC_GOOGLE_CALENDAR_API=
NEXT_PUBLIC_GOOGLE_CALENDER_ID=
NEXT_PUBLIC_GOOGLE_CALENDER_SCOPES=
